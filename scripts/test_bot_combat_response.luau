local Response = require("../src/shared/BotCombatResponse")

local right = Response.reaction(0.9, 0.7, 100, 0.8)
assert(right.hitSide == 0.9 and right.hitFront == 0.7, "Directional hit preserved")
assert(right.suppressedUntil == 102.3, "Healthy bot has a short, finite suppression")
local wounded = Response.reaction(-2, 1.8, 100, 0.3)
assert(wounded.hitSide == -1 and wounded.hitFront == 1, "Hit direction bounded")
assert(math.abs(wounded.suppressedUntil - 103.2) < 1e-6, "Critical health increases cover duration")
assert(Response.shouldTakeCover(0.9, 0.1, false, true), "Fresh suppression triggers cover")
assert(Response.shouldTakeCover(0.5, 4, false, false), "Wounded and recently hit")
assert(Response.shouldTakeCover(1, math.huge, true, false), "Reload seeks cover")
assert(not Response.shouldTakeCover(1, 8, false, false), "Healthy bot resumes combat")
assert(not Response.shouldTakeCover(0.2, -5, false, false), "Invalid future hit cannot trigger")
print("IRON YARD directional bot hit reaction and finite suppression: OK")
