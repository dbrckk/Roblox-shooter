local A = require("../src/shared/AimStancePolicy")
local W = require("../src/shared/WeaponConfig")
local ar, shotgun = W.get("AssaultRifle"), W.get("Shotgun")
assert(not A.ready(nil, 0.4, true, true, 0))
assert(not A.ready(1, 1.1, true, true, 0))
assert(A.ready(1, 1.15, true, true, 0))
assert(A.ready(1, 1.15, true, true, A.MAX_AIM_WALK_SPEED))
assert(not A.ready(1, 1.15, false, true, 0))
assert(not A.ready(1, 1.15, true, false, 0))
assert(not A.ready(1, 1.15, true, true, 26))
assert(not A.ready(1, 1.15, true, true, -1))
assert(not A.ready(1, 1.15, true, true, math.huge))
assert(not A.ready(1, 1.15, true, true, 0/0))
assert(not A.ready(2, 1, true, true, 0))
assert(not A.ready(0/0, 10, true, true, 0))
assert(not A.ready(1, math.huge, true, true, 0))
assert(A.cone("AssaultRifle", ar.spreadDegrees, false) == ar.spreadDegrees)
assert(A.cone("AssaultRifle", ar.spreadDegrees, true) < ar.spreadDegrees)
assert(A.cone("Shotgun", shotgun.spreadDegrees, true) < shotgun.spreadDegrees)
assert(A.cone("Shotgun", shotgun.spreadDegrees, false) == shotgun.spreadDegrees)
assert(A.cone("Pistol", 0, true) == 0)
assert(A.cone("Sniper", 0, true) == 0)
assert(A.cone("Knife", 0, true) == 0)
assert(A.cone("Shotgun", 0/0, true) == nil)
assert(A.cone("Shotgun", math.huge, true) == nil)
assert(A.cone("Shotgun", -2, true) == nil)
assert(A.cone("Shotgun", 46, true) == nil)
local buffed, hip = 0, 0
for i = 1, 40000 do
    local t = 10 + i / 60
    local ready = A.ready(t - 0.15, t, true, true, 20)
    local aimed = A.cone("AssaultRifle", ar.spreadDegrees, ready)
    local normal = A.cone("AssaultRifle", ar.spreadDegrees, false)
    assert(ready and aimed > 0 and aimed <= normal)
    buffed += aimed
    hip += normal
end
assert(buffed < hip and buffed > 0)
print("IRON YARD ADS: 40k shots, sprint, airborne, speed, timings and weapons OK")
