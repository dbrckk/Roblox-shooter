-- Offline tests of the private owner-only, 48-sample bounded microprofiler.
local P = require("../src/shared/WeaponSwapMetrics")
assert(P.WINDOW == 48)
assert(not P.isEnabled() and P.snapshot() == nil)
assert(not P.record("reuse", 0.001, 20, 20))
P.enable(true)
assert(P.isEnabled())
local first = P.snapshot()
assert(first.reuse.count == 0 and first.build.count == 0)
assert(first.cachedParts == nil)
assert(not P.record("unknown", 0.1, 10, 0))
assert(not P.record("build", -1, 10, 0))
assert(not P.record("build", math.huge, 10, 0))
assert(not P.record("build", 0/0, 10, 0))
assert(not P.record("build", 0.01, 0/0, 0))
assert(not P.record("build", 0.01, -1, 0))
assert(not P.record("build", 0.01, 10.1, 0))
assert(P.record("build", 0.010, 23, 18))
assert(P.record("build", 0.030, 22, 0))
assert(P.record("reuse", 0.004, 22, 23))
assert(P.record("lod", 0.050, 30, 12))
assert(P.record("initial", 0.030, 22, 0))
local result = P.snapshot()
assert(result.build.count == 2 and result.reuse.count == 1)
assert(result.build.meanMs == 20 and result.build.p95Ms == 30)
assert(result.build.lastMs == 30 and result.build.peakMs == 30)
assert(result.build.windowCount == 2 and result.reuse.p95Ms == 4)
assert(result.lod.count == 1 and result.initial.count == 1)
assert(result.cachedParts == 0)
P.noteCache(27)
assert(P.snapshot().cachedParts == 27)
P.noteCache(-1)
P.noteCache(0/0)
P.noteCache("0")
assert(P.snapshot().cachedParts == 27, "Bad cache observations never replace valid count")

-- A long Android switching session cannot grow the per-kind sample array.
P.enable(true)
for index = 1, 240 do
    assert(P.record("reuse", index / 1000, 20, 10))
end
local long = P.snapshot()
assert(long.reuse.count == 240 and long.reuse.windowCount == P.WINDOW)
assert(long.reuse.meanMs > 100 and long.reuse.meanMs < 150)
assert(long.reuse.p95Ms >= 235 and long.reuse.p95Ms <= 240)
assert(long.reuse.peakMs == 240 and long.reuse.lastMs == 240)
assert(long.build.count == 0 and long.build.p95Ms == 0)
assert(long.cachedParts == 10)
P.enable(false)
assert(not P.isEnabled() and P.snapshot() == nil)
assert(not P.record("reuse", 0.01, 1, 0))
P.noteCache(12)
P.enable(true)
local clear = P.snapshot()
assert(clear.reuse.count == 0 and clear.cachedParts == nil)
print("IRON YARD: opt-in client swap timings bounded to 48 samples/kind OK")
