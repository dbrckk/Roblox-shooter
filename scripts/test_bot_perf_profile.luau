local Profile = require("../src/shared/BotPerfProfile")
local state = Profile.new(10)
assert(Profile.WINDOW_SECONDS == 5)
assert(Profile.count(state, "think"))
assert(Profile.count(state, "think"))
assert(Profile.count(state, "targetRay", 3))
assert(Profile.count(state, "navRay", 2))
assert(Profile.count(state, "pathStarted"))
assert(Profile.count(state, "moveIssued"))
assert(Profile.timing(state, "thinkMs", 3.3))
assert(Profile.timing(state, "thinkMs", 6.5))
assert(Profile.timing(state, "pathMs", 120.1))
assert(not Profile.count(state, "unknown", 100))
assert(not Profile.count(state, "think", 0 / 0))
assert(not Profile.count(state, "think", -2))
assert(not Profile.timing(state, "pathMs", -1))
assert(not Profile.timing(state, "poseMs", math.huge))
assert(Profile.flush(state, 10, 4) == nil, "Cannot divide by zero seconds")
local p = Profile.flush(state, 15, 6)
assert(p.bots == 4 and p.seconds == 5, "No more than four real bots")
assert(p.rates.think == 0.4 and p.rates.targetRay == 0.6)
assert(p.rates.navRay == 0.4 and p.rates.pathStarted == 0.2)
assert(p.rates.moveIssued == 0.2, "MoveTo rates are counted")
assert(p.timings.thinkMs.mean == 4.9 and p.timings.thinkMs.peak == 6.5)
assert(p.timings.thinkMs.samples == 2)
assert(p.timings.pathMs.mean == 120.1)
assert(p.timings.poseMs.samples == 0 and p.timings.poseMs.mean == 0)
assert(Profile.flush(state, 15, 0) == nil, "No duplicate window")
local blank = Profile.flush(state, 20, 1)
assert(blank.bots == 1 and blank.rates.think == 0 and blank.rates.targetRay == 0)
assert(blank.timings.thinkMs.samples == 0, "Window counters reset correctly")
assert(Profile.count(state, "muzzleRay", 1))
assert(Profile.flush(state, 25, 0).rates.muzzleRay == 0.2)
print("IRON YARD opt-in five-second bot workload aggregates, privacy and reset: OK")
