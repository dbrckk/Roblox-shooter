local Policy = require("../src/shared/DefeatPresentation")
local title,timer,hint = Policy.labels("FFA","LIVE",12,4.1,nil)
assert(title=="ELIMINATED" and timer=="REDEPLOY IN  5s")
assert(string.find(hint,"SPAWN SHIELD",1,true))
title,timer,hint = Policy.labels("FFA","LIVE",12,0,nil)
assert(timer=="REDEPLOYING...")
for _, verdict in ipairs({"ROUND LOST","ROUND DRAW","ROUND WON"}) do
    title,timer,hint=Policy.labels("DUEL","DUEL_BREAK",6.3,999,verdict)
    assert(title==verdict and timer=="NEXT BOUT IN  7s")
    assert(string.find(hint,"NO SECOND LIFE",1,true))
end
title,timer,hint=Policy.labels("DUEL","LIVE",80,10,nil)
assert(title=="ELIMINATED" and timer=="AWAITING ROUND RESULT")
title,timer,hint=Policy.labels("DUEL","DUEL_BREAK",0,10,"INVALID")
assert(title=="ROUND FINISHED" and timer=="NEXT BOUT IN  0s")
title,timer,hint=Policy.labels("DUEL","DUEL_BREAK",0/0,math.huge,nil)
assert(timer=="NEXT BOUT IN  0s")
title,timer,hint=Policy.labels("FFA","LIVE",0,-1,nil)
assert(timer=="REDEPLOYING...")
print("IRON YARD defeat presentation: duel transition, draws, bounded countdowns and FFA respawn OK")
