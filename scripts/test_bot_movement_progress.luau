local P = require("../src/shared/BotMovementProgress")
local function sample(s, t, d, shift, mode, modeAge, pathing)
    return P.step(s, t, d, shift, mode, modeAge, pathing)
end
local s, stuck, progress = sample(nil, 0, 30, math.huge, "DIRECT", 0, false)
assert(not stuck and not progress and s.referenceDistance == 30, "Initial baseline")
s, stuck, progress = sample(s, 1, 29.55, 0, "DIRECT", 1, false)
assert(not stuck and not progress, "Small movement is not forward progress")
s, stuck, progress = sample(s, 2, 29.25, 0, "DIRECT", 2, false)
assert(not stuck and not progress, "Sliding in place must not reset the timer")
s, stuck, progress = sample(s, 2.81, 29.15, 0, "DIRECT", 2.81, false)
assert(stuck and not progress, "Persistent tiny displacements must recover")
s, stuck, progress = sample(s, 3.1, 27.8, 0, "DIRECT", 3.1, false)
assert(not stuck and progress, "Sufficient progress resets the stall counter")
s, stuck, progress = sample(s, 5, 28, 10, "PATH", 0, false)
assert(not stuck and not progress and s.since == 5, "Switching waypoint resets baseline")
s, stuck = sample(s, 11, 28, 0, "WAIT", 1, true)
assert(not stuck, "Pending async path cannot be interrupted by the monitor")
s, stuck = sample(s, 11.1, 28, 0, "WAIT", 3, false)
assert(not stuck, "Waiting for a valid route has a grace period")
s, stuck = sample(s, 11.5, 28, 0, "WAIT", 5, false)
assert(stuck, "An exhausted wait eventually triggers safe reroute")
s, stuck = sample(s, 13, 3, 0, "PATH", 10, false)
assert(not stuck, "Reached waypoint never triggers recovery")
s, stuck = sample(s, 14, 32, math.huge, "PATH", 1, false)
assert(not stuck and s.referenceDistance == 32, "New target baseline")
s, stuck = sample(s, 20, 32, 0 / 0, "PATH", 1, false)
assert(not stuck and s.since == 20, "Invalid goal shift forces safe rebaseline")
s, stuck = sample(s, 21, 0 / 0, 0, "DIRECT", 2, false)
assert(s == nil and not stuck, "Invalid distance cannot trigger physics recovery")
print("IRON YARD waypoint-relative progress and bounded bot recovery: OK")
