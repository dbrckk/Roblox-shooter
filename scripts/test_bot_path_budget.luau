local Budget = require("../src/shared/BotPathBudget")
assert(Budget.MAX_IN_FLIGHT == 2)
assert(Budget.MIN_START_GAP >= 0.15)
assert(Budget.LEASE_SECONDS > 5)
assert(Budget.MOVE_REFRESH_SECONDS < 3)

local state = Budget.new()
local first = Budget.claim(state, 1)
assert(first and Budget.inFlight(state) == 1)
assert(Budget.claim(state, 1.04) == nil, "Stagger path starts")
local second = Budget.claim(state, 1.20)
assert(second and second ~= first and Budget.inFlight(state) == 2)
assert(Budget.claim(state, 1.50) == nil, "Third physical engine call denied")
assert(Budget.valid(state, first, 1.50))
assert(Budget.release(state, first))
assert(not Budget.release(state, first))
local third = Budget.claim(state, 1.60)
assert(third and third > second and Budget.inFlight(state) == 2)

assert(Budget.valid(state, second, 6.99))
assert(not Budget.valid(state, second, 7.01), "Late result cannot mutate bot")
assert(Budget.claim(state, 7.60) == nil,
    "Expired lease cannot silently admit a third running ComputeAsync")
assert(Budget.inFlight(state) == 2, "Actual running calls retain both slots")
assert(Budget.release(state, second), "Late completion frees only its own slot")
assert(Budget.inFlight(state) == 1)
local fourth = Budget.claim(state, 7.60)
assert(fourth and fourth > third)
assert(not Budget.valid(state, third, 7.60))
assert(Budget.claim(state, 8.0) == nil, "Other late engine call still occupies slot")
assert(Budget.release(state, third))
assert(Budget.release(state, fourth))
assert(Budget.inFlight(state) == 0)
assert(not Budget.release(state, 9999))

local a = Budget.claim(state, 8)
assert(a)
assert(Budget.claim(state, math.huge) == nil)
assert(Budget.claim(state, 0/0) == nil)
assert(Budget.release(state, a))
assert(Budget.shouldIssueMove(math.huge, math.huge))
assert(Budget.shouldIssueMove(2, 0.1))
assert(not Budget.shouldIssueMove(0.20, 0.2))
assert(not Budget.shouldIssueMove(1.0, 0.6))
assert(Budget.shouldIssueMove(0.0, 1.2))
assert(Budget.shouldIssueMove(0/0, 0))
assert(Budget.shouldIssueMove(0.0, -1))
print("IRON YARD physical ComputeAsync concurrency, late callbacks and MoveTo: OK")
