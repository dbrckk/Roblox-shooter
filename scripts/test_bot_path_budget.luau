local Budget = require("../src/shared/BotPathBudget")
assert(Budget.MAX_IN_FLIGHT == 2, "At most two concurrent navmesh calculations")
assert(Budget.MIN_START_GAP >= 0.15, "Path starts must be staggered")
assert(Budget.LEASE_SECONDS > 5, "Ticket lives past existing 5s bot path timeout")
assert(Budget.MOVE_REFRESH_SECONDS < 3, "Humanoid MoveTo refreshed before timeout")

local state = Budget.new()
local first = Budget.claim(state, 1)
assert(first, "First eligible bot starts promptly")
assert(Budget.claim(state, 1.04) == nil, "A burst cannot start simultaneous queries")
local second = Budget.claim(state, 1.20)
assert(second and second ~= first, "Second bot can compute after stagger")
assert(Budget.claim(state, 1.50) == nil, "Third bot cannot overload navmesh")
assert(Budget.valid(state, first, 1.50)
    and Budget.valid(state, second, 1.50), "Active ComputeAsync slots held")
assert(Budget.release(state, first), "A completed route frees its own token")
assert(not Budget.release(state, first), "Double-release cannot free other work")
local third = Budget.claim(state, 1.60)
assert(third and third > second, "A waiting bot can start after the slot frees")
assert(Budget.claim(state, 1.90) == nil, "No third active slot after handoff")

assert(Budget.valid(state, second, 6.99), "Long running path retains its own token")
assert(not Budget.valid(state, second, 7.01), "Expired path result must be discarded")
local fourth = Budget.claim(state, 7.60)
assert(fourth and fourth > third, "Orphan leases expire after hung ComputeAsync")
assert(not Budget.valid(state, third, 7.60), "Old discarded route cannot be accepted")
assert(Budget.release(state, fourth))
assert(not Budget.release(state, 9999), "Unknown token is inert")

local a = Budget.claim(state, 8)
assert(a, "Normal scheduling continues after expired leases")
assert(Budget.claim(state, math.huge) == nil)
assert(Budget.claim(state, 0/0) == nil)
assert(Budget.release(state, a))

assert(Budget.shouldIssueMove(math.huge, math.huge),
    "New waypoint is issued immediately")
assert(Budget.shouldIssueMove(2, 0.1), "Significant target move is immediate")
assert(not Budget.shouldIssueMove(0.20, 0.2), "Stable command not resent at 5Hz")
assert(not Budget.shouldIssueMove(1.0, 0.6), "Small target jitter coalesced")
assert(Budget.shouldIssueMove(0.0, 1.2), "Stationary goal refreshed before timeout")
assert(Budget.shouldIssueMove(0/0, 0), "Invalid steering distance fails open")
assert(Budget.shouldIssueMove(0.0, -1), "Clock reset cannot suppress movement")
print("IRON YARD global ComputeAsync concurrency, lease cleanup and MoveTo budget: OK")
