local P = require("../src/shared/BotSoundSearchPlan")
assert(P.PHASE_COUNT == 3)
local p1 = P.offsets(1, 1)
local p2 = P.offsets(2, 1)
local p3 = P.offsets(3, 1)
assert(#p1 == 3 and #p2 == 3 and #p3 == 3)
assert(p1[1].forward == 0 and p1[1].lateral == 0, "Inspect coarse area first")
assert(p2[1].lateral == -p3[1].lateral, "Search both sides")
assert(P.offsets(2, -1)[1].lateral == -p2[1].lateral, "Mirror search per bot")
assert(#P.offsets(4, 1) == 0, "No endless sweep phases")
local step, changed, finished = P.advance(1, 0, 0, 2, 44)
assert(step == 1 and not changed and not finished, "Preserve travel time")
step, changed, finished = P.advance(1, 0, 0, 7, 25)
assert(step == 2 and changed and not finished, "First leg times out into second")
step, changed, finished = P.advance(2, 0, 7, 9, 4)
assert(step == 3 and changed and not finished, "Arriving near side sweeps onward")
step, changed, finished = P.advance(3, 0, 9, 11, 3)
assert(step == nil and changed and finished, "Last leg terminates after arrival")
step, changed, finished = P.advance(1, 0, 0, 17, 65)
assert(step == nil and finished, "Maximum time bounds pursuit")
step, changed, finished = P.advance(1, 0, 0, 1, 0/0)
assert(step == nil and finished, "Invalid geometric inputs fail closed")
print("IRON YARD bounded three-point gunshot search and expiry: OK")
