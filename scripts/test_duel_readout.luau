local R = require("../src/shared/DuelReadout")
local a,b=R.scores(111,111,222,3,1)
assert(a==3 and b==1)
a,b=R.scores(222,111,222,3,1)
assert(a==1 and b==3)
assert(R.scores(333,111,222,3,1)==nil)
assert(R.scores(111,111,111,3,1)==nil)
assert(R.scores(111,111,222,0/0,1)==nil)
assert(R.scores(111,111,222,-1,1)==nil)
assert(R.scores(111,111,222,6,1)==nil)
assert(R.scores(111,111,222,1.1,1)==nil)
assert(R.scores(0,111,222,3,1)==nil)
local studioMine, studioRival = R.scores(-1,-1,-2,3,2)
assert(studioMine == 3 and studioRival == 2)
studioMine, studioRival = R.scores(-2,-1,-2,3,2)
assert(studioMine == 2 and studioRival == 3)
assert(R.boutLabel("A",-1,-1,-2)=="ROUND WON")
assert(R.boutLabel("A",-2,-1,-2)=="ROUND LOST")
assert(R.scores(-3,-1,-2,3,2)==nil)
assert(R.scores(0,-1,-2,3,2)==nil)
for i=0,5 do
    for j=0,5 do
        local mine,rival=R.scores(111,111,222,i,j)
        assert(mine==i and rival==j)
        mine,rival=R.scores(222,111,222,i,j)
        assert(mine==j and rival==i)
    end
end
assert(R.boutLabel("A",111,111,222)=="ROUND WON")
assert(R.boutLabel("A",222,111,222)=="ROUND LOST")
assert(R.boutLabel("B",111,111,222)=="ROUND LOST")
assert(R.boutLabel("B",222,111,222)=="ROUND WON")
assert(R.boutLabel("DRAW",111,111,222)=="ROUND DRAW")
assert(R.boutLabel("DRAW",222,111,222)=="ROUND DRAW")
assert(R.boutLabel("",111,111,222)==nil)
assert(R.boutLabel("A",333,111,222)==nil)
assert(R.boutLabel("A",111,111,111)==nil)
print("IRON YARD duel scoreboard: local/rival perspective, server outcomes and invalid input OK")
