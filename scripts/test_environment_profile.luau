local P = require("../src/shared/EnvironmentProfile")
local eco = P.get("ECO", true)
assert(eco.lamps == 0 and eco.bloom == false, "Eco disables dynamic lamps and bloom")
assert(eco.density < 0.1 and eco.exposure > 0, "Eco must preserve readable gameplay contrast")
local mobile = P.get("BALANCED", true)
local desktop = P.get("BALANCED", false)
local mq = P.get("QUALITY", true)
local dq = P.get("QUALITY", false)
assert(mobile.lamps == 2 and desktop.lamps == 4, "Mobile balanced light budget")
assert(mq.lamps == 4 and not mq.bloom, "Quality mobile avoids blooming white UI")
assert(dq.lamps == 8 and dq.bloom, "Quality PC can add restrained sun glints")
assert(dq.density <= 0.15 and dq.haze < 0.6, "Visual atmosphere cannot obscure combat")
local indices = P.activeFixtureIndices({70, 20, 120, 15, 400}, "BALANCED", true)
assert(indices[2] and indices[4] and not indices[1], "Nearest two lights win on mobile")
assert(not indices[3] and not indices[5], "Distance and count limits applied")
local ties = P.activeFixtureIndices({10, 10, 10}, "BALANCED", true)
assert(ties[1] and ties[2] and not ties[3], "Tie selection deterministic")
local nils = P.activeFixtureIndices({20, 30}, "ECO", false)
assert(next(nils) == nil, "No lamps active on Eco")
local invalid = P.activeFixtureIndices({0/0, -1, 20}, "QUALITY", false)
assert(invalid[3] and not invalid[1] and not invalid[2], "Reject malformed distances")
print("IRON YARD bright readable daylight, mobile ambient limits and nearest-lamp budgets: OK")
